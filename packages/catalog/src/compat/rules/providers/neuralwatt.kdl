// Neuralwatt Cloud (https://docs.neuralwatt.com): OpenAI-compatible inference
// for open-weight models at https://api.neuralwatt.com/v1.
//
// `GET /v1/models` is public. Each row carries its display name, per-million
// pricing, context and output limits, capability flags, and the reasoning
// efforts the model accepts (https://docs.neuralwatt.com/api/models), which
// `neuralwattModelManagerOptions` maps. `nw-large`, `nw-flash` and `nw-small`
// are tracking aliases that move to newer models over time.
provider "neuralwatt" {
	default-model "nw-large"
	env "NEURALWATT_API_KEY"
	// Discovery runs without a key, so the roster stays current before login.
	// Inference still needs one.
	allow-unauthenticated #true
	dynamic-models-authoritative #true
	// Same-id rows on other hosts describe different deployments.
	skip-cross-provider-reference-fills #true
	// A key adds the rows private to its account. Generation sends none, so
	// those rows stay out of the bundle.
	discovery label="Neuralwatt" allow-unauthenticated=#true anonymous=#true

	// `metadata.limits.max_output_tokens` is null where the model has no output
	// cap below its context window (e.g. `nw-large`). Seed a budget for those
	// rows. omp keeps one output limit per model, used as both the default
	// request and the cap, so explicit requests on these rows stop here too.
	// A reported limit always wins.
	max-tokens-fallback 131072
	// Send up to the model's own output limit instead of the generic 64000
	// ceiling. Reported caps reach 393216, and long reasoning at high effort
	// can outgrow 64000.
	clamp-output-to-model-max #true

	// Rows report `developer_role: false`, so system prompts ride the `system`
	// role. Output caps ride `max_tokens`, and no `store` field is sent.
	supports-developer-role #false
	supports-store #false
	max-tokens-field "max_tokens"

	// Models stream reasoning in `reasoning_content` or `reasoning`. Send it back
	// with each assistant turn so reasoning carries across tool calls. A tracking
	// alias carries no model identity, so without this `nw-large` drops the
	// reasoning that `kimi-k3.1-pro`, the model it points at, keeps through
	// class rules. The alias still lacks the target's other class flags, such
	// as `moonshot-mfjs` tool schemas and required reasoning on tool-call
	// turns. Tool-call follow-ups on `nw-large` succeed without them.
	replay-reasoning-content #true
}
